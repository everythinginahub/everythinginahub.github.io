{
  "name": "revise-like-a-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:client": "esbuild scripts/supabase-entry.js --bundle --format=esm --minify --outfile=public/supabase-client.js --legal-comments=inline",
    "build:ocr": "node scripts/copy-ocr-assets.js",
    "build:pdf": "node scripts/copy-pdf-assets.js",
    "build:gradio": "esbuild scripts/gradio-entry.js --bundle --platform=browser --format=esm --minify --outfile=public/gradio-client.js --legal-comments=inline"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@gradio/client": "^2.7.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1"
  }
}
