{
  "name": "revise-like-a-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:ai-function": "esbuild supabase/functions/ai-chat/index.ts --bundle --format=esm --platform=neutral --external:npm:* --minify --outfile=.cache/ai-chat-deploy.js",
    "build:client": "esbuild scripts/supabase-entry.js --bundle --format=esm --minify --outfile=public/supabase-client.js --legal-comments=inline",
    "build:ocr": "node scripts/copy-ocr-assets.js",
    "build:pdf": "node scripts/copy-pdf-assets.js",
    "build:dice": "node scripts/build-dice-renderer.mjs",
    "build:qr": "node scripts/build-qr-maker.mjs",
    "build:city3d": "esbuild scripts/neon-city-renderer-source.js --bundle --format=esm --minify --legal-comments=inline --outfile=public/neon-city-renderer.bundle.js",
    "build:arcade3d": "node scripts/build-arcade-3d.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "qrcode": "^1.5.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1"
  }
}
